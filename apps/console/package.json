{
  "name": "@payflow/console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint app lib tests",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts tests/*.test.tsx",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.e2e.mjs",
    "test:hosted": "node --test --test-concurrency=1 e2e-hosted/hosted.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "^16.0.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
