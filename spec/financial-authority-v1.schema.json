{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.payflow.invalid/financial-authority/v1/schema.json",
  "title": "Financial Authority Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authorityId", "principal", "agent", "scope", "validity", "execution", "proof"],
  "properties": {
    "version": { "const": "financial-authority/v1" },
    "authorityId": { "type": "string", "minLength": 1 },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "organizationId": { "type": "string" } }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "identityProvider": { "type": "string" } }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "currencies", "maxAmountMinor", "counterparties"],
      "properties": {
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "currencies": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z]{3}$" }, "uniqueItems": true },
        "maxAmountMinor": { "type": "integer", "minimum": 0 },
        "counterparties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "conditions": { "type": "object", "additionalProperties": true }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentAuthorityId": { "type": "string" },
        "parentAgentId": { "type": "string" },
        "depth": { "type": "integer", "minimum": 0 }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuedAt", "expiresAt", "status"],
      "properties": {
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["ACTIVE", "SUSPENDED", "REVOKED", "EXPIRED"] }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeRevalidation", "oneTimeGrant", "idempotency"],
      "properties": {
        "runtimeRevalidation": { "const": true },
        "oneTimeGrant": { "const": true },
        "idempotency": { "const": true },
        "railIndependent": { "type": "boolean" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "const": true },
        "reference": { "type": "string" }
      }
    }
  }
}
