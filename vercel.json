{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/paypal/return",
      "destination": "/api/paypal"
    },
    {
      "source": "/paypal/cancel",
      "destination": "/api/paypal"
    },
    {
      "source": "/paypal/status",
      "destination": "/api/paypal"
    }
  ],
  "functions": {
    "api/paypal.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://www.sandbox.paypal.com https://www.paypal.com; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api-m.sandbox.paypal.com https://api-m.paypal.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/payer-return.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "m7-m60-master-execution": false
    }
  }
}
