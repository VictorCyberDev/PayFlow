# Server-side only. Placeholders; never commit real credentials.
DATABASE_URL=postgres://user:password@localhost:5432/payflow
TEST_DATABASE_URL=postgres://user:password@localhost:5432/payflow_test

# Milestone 2C execution-grant signing. Load PEM material from a secret manager in production.
# Generate Ed25519 keys locally with OpenSSL; never commit the private key.
PAYFLOW_EXECUTION_GRANT_KID=replace-with-rotation-key-id
PAYFLOW_EXECUTION_GRANT_PRIVATE_KEY_PEM=replace-with-secret-at-runtime
PAYFLOW_EXECUTION_GRANT_PUBLIC_KEY_PEM=replace-with-public-key
PAYFLOW_EXECUTION_GRANT_AUDIENCE=payflow.payment-execution
PAYFLOW_EXECUTION_GRANT_TTL_MS=120000

# Reserved for Milestone 2D; PayPal is not integrated in 2C.
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_ENVIRONMENT=sandbox
